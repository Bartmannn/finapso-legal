---
import ButtonLink from '../components/ButtonLink.astro';
import { routes, withBase } from '../config/site.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Nie znaleziono strony"
  description="Pod tym adresem nie ma strony Finapso."
  draft={true}
>
  <section class="hero" aria-labelledby="not-found-title">
    <p class="eyebrow">Błąd 404</p>
    <h1 id="not-found-title">Nie znaleziono strony</h1>
    <p>
      Adres mógł się zmienić albo zawierać literówkę. Regulamin i politykę
      prywatności znajdziesz na stronie głównej.
    </p>
    <div class="button-row">
      <ButtonLink href={withBase(routes.home)}>Wróć na stronę główną</ButtonLink>
    </div>
  </section>
</BaseLayout>
