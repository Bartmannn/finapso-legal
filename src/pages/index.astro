---
import { routes, withBase } from '../config/site.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Finapso"
  description="Regulamin i polityka prywatności aplikacji Finapso."
>
  <section class="legal-reading" aria-labelledby="home-title">
    <h1 id="home-title">Finapso</h1>
    <nav aria-label="Dokumenty Finapso">
      <ul class="document-links">
        <li><a href={withBase(routes.privacy)}>Polityka prywatności</a></li>
        <li><a href={withBase(routes.terms)}>Regulamin</a></li>
      </ul>
    </nav>
  </section>
</BaseLayout>

<style>
  .legal-reading { width: min(100%, 48rem); margin-inline: auto; }
  .document-links { display: grid; gap: 1rem; padding: 0; margin-block-start: 2rem; list-style: none; }
  .document-links a { display: block; min-height: 2.75rem; padding-block: 0.6rem; font-size: 1.2rem; }
</style>
