---
import ButtonLink from '../components/ButtonLink.astro';
import Card from '../components/Card.astro';
import { routes, siteConfig, withBase } from '../config/site.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Finapso',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Android',
  softwareVersion: '1.53.39',
  inLanguage: 'pl',
  url: siteConfig.publicUrl,
  description: 'Aplikacja Android do zapisywania i analizowania wydatków oraz przychodów.',
};
---

<BaseLayout
  title={siteConfig.title}
  description="Finapso pomaga zapisywać wydatki i przychody, sprawdzać budżet oraz analizować codzienne finanse."
  structuredData={structuredData}
>
  <section class="hero hero-home" aria-labelledby="hero-title">
    <p class="eyebrow">Finanse osobiste na Androidzie</p>
    <h1 id="hero-title">Zapisuj i analizuj swoje wydatki i przychody</h1>
    <p>
      Finapso to aplikacja na Androida, która pomaga prowadzić domowy lub firmowy
      budżet. Zapisuj wydatki i przychody, sprawdzaj podsumowania oraz analizuj,
      na co przeznaczasz pieniądze. Twoje podstawowe dane finansowe pozostają na
      telefonie, a najważniejsze funkcje działają bez stałego internetu.
    </p>
    <div class="button-row">
      <ButtonLink href={withBase(routes.features)}>Poznaj funkcje</ButtonLink>
      <ButtonLink href={withBase(routes.docs)} variant="secondary">Dokumenty</ButtonLink>
    </div>
  </section>

  <section class="section-block" aria-labelledby="overview-title">
    <div class="section-heading">
      <h2 id="overview-title">Najważniejsze możliwości Finapso</h2>
    </div>
    <div class="card-grid">
      <Card>
        <span class="feature-icon" aria-hidden="true">↔</span>
        <h3>Budżet i transakcje</h3>
        <p>Zapisuj wydatki i przychody, porządkuj je w kategoriach i sprawdzaj historię wybranego budżetu.</p>
      </Card>
      <Card>
        <span class="feature-icon" aria-hidden="true">◔</span>
        <h3>Pulpit</h3>
        <p>Sprawdzaj miesięczny bilans, saldo, przychody i wydatki oraz zobacz, na co przeznaczasz najwięcej pieniędzy.</p>
      </Card>
      <Card>
        <span class="feature-icon" aria-hidden="true">▥</span>
        <h3>Analizy</h3>
        <p>Analizuj wydatki i przychody, porównuj okresy, obserwuj najważniejsze kategorie i wyciągaj wnioski.</p>
      </Card>
      <Card>
        <span class="feature-icon" aria-hidden="true">◇</span>
        <h3>Planowanie i cele</h3>
        <p>Planuj przyszłe wydatki, twórz cele finansowe i obserwuj, jak zmienia się Twój budżet w czasie.</p>
      </Card>
      <Card>
        <span class="feature-icon" aria-hidden="true">▣</span>
        <h3>Paragony i raporty</h3>
        <p>Odczytuj dane z paragonów, poprawiaj rozpoznane pozycje i twórz przejrzyste raporty z zapisanych informacji.</p>
      </Card>
    </div>
    <p class="section-note">W Finapso znajdziesz również dodatkowe narzędzia, które pomogą Ci podsumować wybrane wydarzenia, sprawdzić efekty oszczędzania i przygotować własną symulację inwestycji.</p>
  </section>

  <section class="section-block" aria-labelledby="daily-title">
    <div class="section-heading">
      <h2 id="daily-title">Dbaj o swój budżet na co dzień</h2>
    </div>
    <div class="prose home-prose">
      <p>Regularne zapisywanie wydatków i przychodów pomaga sprawdzać, na co przeznaczasz pieniądze, zauważać zmiany w kosztach i planować kolejne wydatki.</p>
      <p>Finapso pokazuje informacje na podstawie zapisanych danych. Nie zastępuje porady finansowej, inwestycyjnej ani podatkowej.</p>
    </div>
  </section>
</BaseLayout>
