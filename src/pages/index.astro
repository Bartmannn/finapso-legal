---
import ButtonLink from '../components/ButtonLink.astro';
import Card from '../components/Card.astro';
import { routes, withBase } from '../config/site.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Finapso"
  description="Regulamin i polityka prywatności aplikacji Finapso."
>
  <section class="hero hero-home" aria-labelledby="home-title">
    <p class="eyebrow">Finapso</p>
    <h1 id="home-title">Dokumenty aplikacji</h1>
    <p>Wybierz dokument, który chcesz przeczytać.</p>
  </section>

  <section class="section-block" aria-label="Dokumenty Finapso">
    <div class="card-grid">
      <Card>
        <h2>Regulamin</h2>
        <p>Zasady korzystania z aplikacji Finapso.</p>
        <ButtonLink href={withBase(routes.terms)}>Przeczytaj regulamin</ButtonLink>
      </Card>
      <Card>
        <h2>Polityka prywatności</h2>
        <p>Informacje o danych i prywatności w Finapso.</p>
        <ButtonLink href={withBase(routes.privacy)}>Przeczytaj politykę</ButtonLink>
      </Card>
    </div>
  </section>
</BaseLayout>
