---
import ButtonLink from '../../components/ButtonLink.astro';
import { routes, siteConfig, withBase } from '../../config/site.mjs';
import type { LegalChange } from '../../content/legalSchema';
import LegalLayout from '../../layouts/LegalLayout.astro';

const updatedAt = new Date('2026-08-22T00:00:00Z');
const changeHistory: LegalChange[] = [{
  revision: 'DRAFT-ZAD5',
  date: updatedAt,
  summary: 'Utworzenie demonstracyjnej strony kontaktu i rozdzielenie rodzajów usuwania danych.',
}];
---

<LegalLayout
  title="Wsparcie i prywatność Finapso — szkic"
  description="Demonstracyjna strona kontaktu, pomocy i żądań dotyczących danych Finapso."
  revision="DRAFT-ZAD5"
  updatedAt={updatedAt}
  effectiveAt={null}
  packageName="app.finapso.android"
  status="DRAFT"
  changeHistory={changeHistory}
  appVersion="1.37.25"
>
  <h2 id="kontakt">Kontakt</h2>
  <p>
    Publiczny adres wsparcia i kontaktu w sprawach prywatności to
    <a href={`mailto:${siteConfig.supportEmail}`}>{siteConfig.supportEmail}</a>.
    Nie wysyłaj hasła, PIN-u, pełnej kopii danych ani danych finansowych, jeżeli
    nie są konieczne do opisania problemu.
  </p>
  <div class="button-row">
    <ButtonLink href={`mailto:${siteConfig.supportEmail}?subject=Wsparcie%20Finapso`}>Napisz do wsparcia</ButtonLink>
  </div>

  <h2 id="brak-kont">Brak kont użytkowników</h2>
  <p>
    Finapso obecnie nie tworzy kont użytkowników. Nie istnieje więc konto
    Finapso, które można usunąć przez tę stronę. Dane zapisane na urządzeniu i
    dane dobrowolnie wysłane do wsparcia wymagają dwóch różnych działań.
  </p>

  <h2 id="dane-lokalne">Usuwanie danych lokalnych</h2>
  <ol>
    <li>Otwórz w aplikacji <strong>Ustawienia</strong>, a następnie <strong>Dane aplikacji</strong>.</li>
    <li>Wybierz pełne czyszczenie danych i przeczytaj oba potwierdzenia.</li>
    <li>Zapisz wymaganą kopię w bezpiecznej lokalizacji; anulowanie zapisu zatrzymuje usuwanie.</li>
    <li>Jeżeli PIN jest aktywny, potwierdź operację zgodnie z ekranem aplikacji.</li>
  </ol>
  <p>
    Szczegóły kopii i osobnego zarządzania materiałami paragonów opisuje strona
    <a href={withBase(routes.dataAndBackups)}>Dane i kopie</a>.
  </p>

  <h2 id="dane-wsparcia">Żądanie usunięcia danych przesłanych do wsparcia</h2>
  <p>
    Aby poprosić o wcześniejsze usunięcie dobrowolnie przesłanego zgłoszenia lub
    załączników, napisz z adresu użytego w zgłoszeniu. Podaj orientacyjną datę i
    temat wiadomości, aby można było odnaleźć właściwy materiał. Nie dołączaj
    ponownie danych, które mają zostać usunięte.
  </p>
  <div class="button-row">
    <ButtonLink href={`mailto:${siteConfig.supportEmail}?subject=Usuni%C4%99cie%20danych%20zg%C5%82oszenia%20Finapso`} variant="secondary">
      Poproś o usunięcie danych zgłoszenia
    </ButtonLink>
  </div>

  <h2 id="czas-odpowiedzi">Czas odpowiedzi i finalny proces</h2>
  <p>
    Termin odpowiedzi, sposób weryfikacji żądania oraz okresy retencji zostaną
    zatwierdzone w finalnej polityce. Ten szkic nie ustanawia jeszcze wiążącego
    procesu ani terminu realizacji.
  </p>
</LegalLayout>
