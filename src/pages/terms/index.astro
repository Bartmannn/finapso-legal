---
import { getEntry, render } from 'astro:content';

import LegalLayout from '../../layouts/LegalLayout.astro';

const entry = await getEntry('legal', 'terms');

if (!entry) {
  throw new Error('Brak wpisu kolekcji dla trasy /terms/.');
}

const { Content, headings } = await render(entry);
---

<LegalLayout
  title={entry.data.title}
  description={entry.data.description}
  headings={headings}
  revision={entry.data.revision}
  updatedAt={entry.data.updatedAt}
  effectiveAt={entry.data.effectiveAt}
  packageName={entry.data.packageName}
  status={entry.data.status}
  changeHistory={entry.data.changeHistory}
  appVersion={entry.data.appVersion}
>
  <Content />
</LegalLayout>
