---
import { getEntry, render } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';

const entry = await getEntry('legal', 'privacy-placeholder');

if (!entry) {
  throw new Error('Brak technicznego wpisu kolekcji dla trasy /privacy/.');
}

const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} draft={entry.data.draft}>
  <article>
    <p class="draft-notice" role="status">
      Wersja techniczna — nie jest polityką prywatności i nie może zostać użyta
      w Google Play Console.
    </p>
    <h1>{entry.data.title}</h1>
    <dl class="metadata">
      <div>
        <dt>Rewizja</dt>
        <dd>{entry.data.revision}</dd>
      </div>
      <div>
        <dt>Aktualizacja</dt>
        <dd><time datetime={entry.data.updatedAt.toISOString()}>{entry.data.updatedAt.toLocaleDateString('pl-PL')}</time></dd>
      </div>
    </dl>
    <Content />
  </article>
</BaseLayout>
