---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ButtonLink from '../../components/ButtonLink.astro';
import { routes, withBase } from '../../config/site.mjs';
import BaseLayout from '../../layouts/BaseLayout.astro';

const documents = [
  {
    href: routes.terms,
    title: 'Regulamin użytkowania Finapso',
    version: '1.0',
    effectiveAt: '29.09.2026',
    description: 'Zasady korzystania z aplikacji Finapso.',
    action: 'Przeczytaj regulamin',
  },
  {
    href: routes.privacy,
    title: 'Polityka prywatności Finapso',
    version: '1.0',
    effectiveAt: '28.09.2026',
    description: 'Informacje o danych lokalnych, kontakcie, usługach zewnętrznych i prawach użytkownika.',
    action: 'Przeczytaj politykę prywatności',
  },
];
---

<BaseLayout
  title="Dokumenty"
  description="Regulamin użytkowania i polityka prywatności aplikacji Finapso."
>
  <Breadcrumbs items={[
    { label: 'Strona główna', href: withBase(routes.home) },
    { label: 'Dokumenty' },
  ]} />

  <header class="page-header">
    <h1>Dokumenty Finapso</h1>
    <p class="page-lead">
      Tutaj znajdziesz aktualny regulamin użytkowania oraz politykę prywatności.
    </p>
  </header>

  <section class="document-card-grid" aria-label="Dokumenty Finapso">
    {documents.map((document) => (
      <article class="document-card">
        <div>
          <h2>{document.title}</h2>
          <dl class="document-summary">
            <div><dt>Wersja</dt><dd>{document.version}</dd></div>
            <div><dt>Obowiązuje od</dt><dd>{document.effectiveAt}</dd></div>
          </dl>
          <p>{document.description}</p>
        </div>
        <ButtonLink href={withBase(document.href)} variant="secondary">{document.action}</ButtonLink>
      </article>
    ))}
  </section>
</BaseLayout>
