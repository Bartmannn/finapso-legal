---
import type { MarkdownHeading } from 'astro';

import Breadcrumbs from '../components/Breadcrumbs.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { routes, withBase } from '../config/site.mjs';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  headings?: MarkdownHeading[];
  draft?: boolean;
  updatedAt?: Date;
  revision?: string;
  appVersion?: string | null;
}

const {
  title,
  description,
  headings = [],
  draft = false,
  updatedAt,
  revision,
  appVersion,
} = Astro.props;
---

<BaseLayout title={title} description={description} draft={draft} pageKind="docs">
  <Breadcrumbs items={[
    { label: 'Strona główna', href: withBase(routes.home) },
    { label: 'Dokumentacja', href: withBase(routes.docs) },
    { label: title },
  ]} />
  <header class="page-header">
    <p class="eyebrow">Dokumentacja</p>
    <h1>{title}</h1>
    <p class="page-lead">{description}</p>
    {(updatedAt || revision || appVersion) && (
      <dl class="document-metadata">
        {revision && <div><dt>Rewizja</dt><dd>{revision}</dd></div>}
        {appVersion && <div><dt>Wersja aplikacji</dt><dd>{appVersion}</dd></div>}
        {updatedAt && (
          <div>
            <dt>Aktualizacja</dt>
            <dd><time datetime={updatedAt.toISOString()}>{updatedAt.toLocaleDateString('pl-PL')}</time></dd>
          </div>
        )}
      </dl>
    )}
  </header>
  <div class="document-grid">
    <div class="document-main prose"><slot /></div>
    <TableOfContents headings={headings} />
  </div>
</BaseLayout>
