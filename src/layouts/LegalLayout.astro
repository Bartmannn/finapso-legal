---
import type { MarkdownHeading } from 'astro';

import Breadcrumbs from '../components/Breadcrumbs.astro';
import LegalDraftNotice from '../components/LegalDraftNotice.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { routes, withBase } from '../config/site.mjs';
import type { LegalChange, LegalDocumentStatus } from '../content/legalSchema';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  headings?: MarkdownHeading[];
  revision: string;
  updatedAt: Date;
  effectiveAt: Date | null;
  packageName: string;
  status: LegalDocumentStatus;
  changeHistory: LegalChange[];
  appVersion?: string | null;
  breadcrumbs?: { label: string; href?: string }[];
}

const {
  title,
  description,
  headings = [],
  revision,
  updatedAt,
  effectiveAt,
  packageName,
  status,
  changeHistory,
  appVersion,
  breadcrumbs,
} = Astro.props;
const isDraft = status === 'DRAFT';
const breadcrumbItems = breadcrumbs ?? [
  { label: 'Strona główna', href: withBase(routes.home) },
  { label: title },
];
---

<BaseLayout title={title} description={description} draft={isDraft} pageKind="legal">
  <Breadcrumbs items={breadcrumbItems} />
  {isDraft && <LegalDraftNotice />}
  <header class="page-header">
    <p class="eyebrow">Centrum prawne</p>
    <h1>{title}</h1>
    <p class="page-lead">{description}</p>
    <dl class="document-metadata">
      <div><dt>Status</dt><dd><span class:list={['document-status', isDraft && 'document-status-draft']}>{status}</span></dd></div>
      <div><dt>Rewizja</dt><dd>{revision}</dd></div>
      <div>
        <dt>Aktualizacja</dt>
        <dd><time datetime={updatedAt.toISOString().slice(0, 10)}>{updatedAt.toLocaleDateString('pl-PL')}</time></dd>
      </div>
      <div>
        <dt>Obowiązuje od</dt>
        <dd>{effectiveAt
          ? <time datetime={effectiveAt.toISOString().slice(0, 10)}>{effectiveAt.toLocaleDateString('pl-PL')}</time>
          : 'Nie obowiązuje — szkic'}</dd>
      </div>
      <div><dt>Pakiet Android</dt><dd><code>{packageName}</code></dd></div>
      {appVersion && <div><dt>Wersja aplikacji</dt><dd>{appVersion}</dd></div>}
    </dl>
  </header>
  <section class="change-history" aria-labelledby="change-history-title">
    <h2 id="change-history-title">Historia zmian dokumentu</h2>
    <ol>
      {changeHistory.map((change) => (
        <li>
          <strong>{change.revision}</strong>
          {' — '}
          <time datetime={change.date.toISOString().slice(0, 10)}>{change.date.toLocaleDateString('pl-PL')}</time>
          <span> — {change.summary}</span>
        </li>
      ))}
    </ol>
  </section>
  <div class="document-grid">
    <article class="document-main prose"><slot /></article>
    <TableOfContents headings={headings} />
  </div>
</BaseLayout>
