---
import type { MarkdownHeading } from 'astro';

import Breadcrumbs from '../components/Breadcrumbs.astro';
import LegalDraftNotice from '../components/LegalDraftNotice.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { routes, withBase } from '../config/site.mjs';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  headings?: MarkdownHeading[];
  revision: string;
  effectiveAt: Date | null;
  draft?: boolean;
  breadcrumbs?: { label: string; href?: string }[];
}

const {
  title,
  description,
  headings = [],
  revision,
  effectiveAt,
  draft = false,
  breadcrumbs,
} = Astro.props;
const displayVersion = revision.replace(/-MVP$/i, '');
const breadcrumbItems = breadcrumbs ?? [
  { label: 'Strona główna', href: withBase(routes.home) },
  { label: title },
];
---

<BaseLayout title={title} description={description} draft={draft} pageKind="legal">
  <Breadcrumbs items={breadcrumbItems} />
  {draft && <LegalDraftNotice />}
  <header class="page-header">
    <h1>{title}</h1>
    <p class="page-lead">{description}</p>
    <dl class="document-metadata">
      <div><dt>Wersja</dt><dd>{displayVersion}</dd></div>
      <div>
        <dt>Obowiązuje od</dt>
        <dd>{effectiveAt
          ? <time datetime={effectiveAt.toISOString().slice(0, 10)}>{effectiveAt.toLocaleDateString('pl-PL')}</time>
          : draft ? 'Nie obowiązuje — szkic' : 'Data zostanie podana po publikacji'}</dd>
      </div>
    </dl>
  </header>
  <div class="document-grid">
    <article class="document-main prose"><slot /></article>
    <TableOfContents headings={headings} />
  </div>
</BaseLayout>
