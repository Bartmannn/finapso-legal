{
  "name": "finapso-legal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11.13.0 <12"
  },
  "scripts": {
    "dev": "node --env-file=config/astro.env ./node_modules/astro/bin/astro.mjs dev",
    "check": "node --env-file=config/astro.env ./node_modules/astro/bin/astro.mjs check",
    "build": "node --env-file=config/astro.env ./node_modules/astro/bin/astro.mjs build",
    "check:product-pages": "node scripts/check-product-pages.mjs",
    "preview": "node --env-file=config/astro.env ./node_modules/astro/bin/astro.mjs preview"
  },
  "dependencies": {
    "astro": "7.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "24.13.3",
    "typescript": "6.0.3"
  },
  "optionalDependencies": {
    "sharp": "0.35.3"
  }
}
